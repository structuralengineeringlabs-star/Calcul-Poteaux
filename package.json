{
  "name": "poteaux-ec2",
  "private": true,
  "version": "4.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "validation": "tsx scripts/validation.ts",
    "e2e": "playwright test",
    "e2e:tous": "E2E_TOUS=1 playwright test",
    "manuel": "playwright test -c playwright.manuel.config.ts",
    "site": "vite build && cd dist && zip -qr ../poteaux-ec2-site.zip . && echo 'Archive prête : poteaux-ec2-site.zip'"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "pagedjs": "^0.4.3",
    "pdfmake": "^0.2.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^15.11.7",
    "pdfjs-dist": "^4.10.38",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}